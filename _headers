/*
  # ── Clickjacking (legacy browsers) ──────────────────────────────────────
  X-Frame-Options: DENY

  # ── MIME-type sniffing ───────────────────────────────────────────────────
  X-Content-Type-Options: nosniff

  # ── Referrer informatie beperken ─────────────────────────────────────────
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Cross-Origin isolatie ────────────────────────────────────────────────
  # Voorkomt dat andere origins een referentie naar dit venster krijgen
  Cross-Origin-Opener-Policy: same-origin

  # ── Browser-features uitschakelen ────────────────────────────────────────
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), xr-spatial-tracking=()

  # ── HSTS ─────────────────────────────────────────────────────────────────
  # preload weglaten tot site bewezen stabiel is op definitief domein
  # (preload = éénrichtingsticket naar browser preload list)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Content Security Policy ───────────────────────────────────────────────
  # default-src 'none' = alles geblokkeerd tenzij expliciet toegelaten
  #
  # ⚠ TIJDELIJK (sinds 2026-08-11): style-src staat 'unsafe-inline' toe zodat
  # Google Tag Assistant's debug-badge (?gtm_debug=) volledig kan renderen voor
  # de conversieverificatie in Google Ads. De badge injecteert inline stijlen
  # met wisselende inhoud, dus hash-pinning werkt daar niet betrouwbaar voor.
  # ZODRA de campagne-verificatie in Google Ads geslaagd is: zet dit terug naar
  # de hash-gebaseerde versie (Klaro-hashes, geen 'unsafe-inline').
  Content-Security-Policy: default-src 'none'; script-src 'self' https://identity.netlify.com https://www.googletagmanager.com 'sha256-q1NGZz+MmobRabe2QmyhJcDCqKGIcn3nvbPiuLo06Po='; style-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; media-src 'none'; connect-src 'self' https://api.netlify.com https://identity.netlify.com https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; worker-src 'none'; manifest-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.netlify.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; report-uri /.netlify/functions/csp-report

# ── Cache: fonts & images (nooit gewijzigd, dus immutable) ───────────────
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

/assets/Images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# ── Cache: css & js (wijzigen bij deploys, geen immutable) ───────────────
# Zolang er geen content-hashing is (Eleventy), altijd hervalideren.
/assets/css/*
  Cache-Control: no-cache, must-revalidate
  Cross-Origin-Resource-Policy: cross-origin

/assets/js/*
  Cache-Control: no-cache, must-revalidate
  Cross-Origin-Resource-Policy: cross-origin

# ── Cache: HTML pagina's ──────────────────────────────────────────────────
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# ── Decap CMS admin ──────────────────────────────────────────────────────
/admin/*
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://identity.netlify.com https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.netlify.com https://identity.netlify.com; frame-src https://*.netlify.app; form-action 'self' https://api.netlify.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
